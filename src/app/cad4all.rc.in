// SPDX-License-Identifier: GPL-3.0-or-later
// Version and author shown in the properties of CAD4All.exe on Windows.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041004B0"
        BEGIN
            VALUE "CompanyName", "@CAD4ALL_AUTHOR@"
            VALUE "FileDescription", "CAD4All - CAD 2D e 3D parametrico"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "CAD4All"
            VALUE "LegalCopyright", "Copyright (C) @CAD4ALL_YEARS@ @CAD4ALL_AUTHOR@. Licenza GNU GPL 3 o successiva."
            VALUE "OriginalFilename", "CAD4All.exe"
            VALUE "ProductName", "CAD4All"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0410, 1200
    END
END
